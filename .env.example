# Telegram: crear con @BotFather
TELEGRAM_BOT_TOKEN=

# Supabase: Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Opcional para crear tablas por script. Si no lo usás, pegá supabase/schema.sql en SQL Editor.
# Supabase: Project Settings > Database > Connection string
SUPABASE_DB_URL=

# Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Cerebras (opcional): clasificacion de texto e interpretacion de gastos mas rapida,
# con fallback automatico a Gemini si falla o si no completas esto.
# Conseguis una key gratis en cloud.cerebras.ai. Podes poner varias separadas por coma
# en CEREBRAS_API_KEYS, o CEREBRAS_API_KEY_2, CEREBRAS_API_KEY_3, etc (mismo patron que Gemini).
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

# Fase 5: secreto compartido que valida los POST del Google Apps Script
# que corre en la casilla Gmail compartida (ver gmail-apps-script/Code.gs).
# Generá cualquier string largo random y ponelo también como propiedad
# INGEST_SECRET en el script de Apps Script.
GMAIL_INGEST_SECRET=

# Notion opcional: integración interna + página compartida con la integración
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=

# Si ya corriste setup:notion, se usa notion-databases.json.
# También podés setear este ID manualmente si querés saltarte el archivo.
NOTION_ITEMS_DATABASE_ID=
